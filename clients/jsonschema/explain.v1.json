        "last_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seen"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "title": "ClusterEvidence",
      "type": "object"
    },
    "Confidence": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "label",
        "score"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "EvidenceItem": {
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "LlmProvenance": {
      "properties": {
        "used": {
          "title": "Used",
          "type": "boolean"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "fell_back": {
          "title": "Fell Back",
          "type": "boolean"
        }
      },
      "required": [
        "used",
        "provider",
        "model",
        "fell_back"
      ],
      "title": "LlmProvenance",
      "type": "object"
    },
    "TimeWindow": {
      "description": "Inclusive analysis window. Serialized as ``from`` / ``to`` (ISO-8601).",
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "TriggerInfo": {
      "properties": {
        "detected": {
          "title": "Detected",
          "type": "boolean"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "correlation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation"
        }
      },
      "required": [
        "detected"
      ],
      "title": "TriggerInfo",
      "type": "object"
    }
