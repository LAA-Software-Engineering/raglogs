  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "default",
      "title": "Scope",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/TriggerInfo"
    },
    "primary_cluster": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "secondary_clusters": {
      "items": {
        "$ref": "#/$defs/ClusterEvidence"
      },
      "title": "Secondary Clusters",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "llm": {
      "$ref": "#/$defs/LlmProvenance"
    },
    "rendered_text": {
      "default": "",
      "title": "Rendered Text",
      "type": "string"
    },
    "markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Markdown"
    },
    "cached": {
      "default": false,
      "title": "Cached",
      "type": "boolean"
    },
    "total_logs": {
      "default": 0,
      "title": "Total Logs",
      "type": "integer"
    },
    "mode": {
      "default": "rules",
      "title": "Mode",
      "type": "string"
    },
    "services_affected": {
      "items": {
        "type": "string"
      },
      "title": "Services Affected",
      "type": "array"
    }
  },
  "required": [
    "window",
    "confidence",
    "summary",
    "trigger",
    "llm"
  ],
  "title": "ExplainResponse",
  "type": "object"
}
