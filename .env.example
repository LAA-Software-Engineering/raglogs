# ─────────────────────────────────────────────────────────────────────────────
# raglogs — environment configuration
# Copy this file to .env and fill in your values.
# All variables are optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string with pgvector extension.
# Driver must be psycopg (v3), not psycopg2.
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/raglogs

# Docker Compose default (already set in docker-compose.yml, override here
# only if you're pointing at an external database):
# DB_URL=postgresql+psycopg://postgres:postgres@postgres:5432/raglogs


# ── LLM provider ─────────────────────────────────────────────────────────────
# Controls the explain and ask commands.
# Options: disabled | openai | ollama
# Default: disabled  (deterministic rules-based output, no API calls)
LLM_PROVIDER=disabled

# Model to use when LLM_PROVIDER is openai or ollama.
# OpenAI examples : gpt-4.1-mini  gpt-4.1  gpt-4o
# Ollama examples : llama3  mistral  phi3
LLM_MODEL=gpt-4.1-mini

# API key and base URL for OpenAI (used when LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# When LLM_PROVIDER=ollama, set the Ollama server URL.
OLLAMA_BASE_URL=http://localhost:11434


# ── Embeddings provider ───────────────────────────────────────────────────────
# Controls semantic cluster merging at analysis time (explain / clusters /
# timeline / compare) and semantic `ask` over stored pgvector embeddings.
# Options: disabled | openai | local
# Default: disabled  — fingerprint-only clustering; ask uses keyword retrieval
EMBEDDINGS_PROVIDER=disabled

# Embedding model (used when provider is openai or local).
# OpenAI: text-embedding-3-small
# Local:  a sentence-transformers model name (requires raglogs[local-embeddings])
EMBEDDINGS_MODEL=text-embedding-3-small

# Embedding vector dimensions — must match the model output AND the stored
# log_embeddings column (Vector(1536)). Persist and semantic ask skip when this
# is not 1536. text-embedding-3-small = 1536, text-embedding-3-large = 3072
EMBEDDINGS_DIMENSIONS=1536

# Merge fingerprint clusters whose representative messages have cosine
# similarity >= this threshold. Conservative default: safer to under-merge
# than to collapse distinct errors. Ignored when EMBEDDINGS_PROVIDER=disabled.
CLUSTER_MERGE_SIMILARITY_THRESHOLD=0.92

# Minimum cluster count to participate in a merge. 1 = singletons may merge.
CLUSTER_MERGE_MIN_COUNT=1

# Semantic ask (pgvector over log_embeddings). Looser than cluster-merge
# because questions paraphrase. Ignored when embeddings are missing/disabled;
# ask then falls back to keyword search.
ASK_SEMANTIC_TOP_K=100
ASK_SEMANTIC_MIN_SIMILARITY=0.75


# ── Analysis tuning ───────────────────────────────────────────────────────────
# Baseline comparison window for the explain command.
# Format: <number><unit> where unit is s/m/h/d  (e.g. 24h, 2d, 1h)
DEFAULT_BASELINE_WINDOW=24h

# Maximum number of evidence bullet points in an incident summary.
MAX_EVIDENCE_ITEMS=8

# Maximum number of clusters fed into the explain pipeline.
# Higher = more thorough but slower for large ingestions.
MAX_CLUSTERS_FOR_EXPLAIN=10


# ── Worker ────────────────────────────────────────────────────────────────────
# ── HTTP API auth ─────────────────────────────────────────────────────────────
# Default AUTH_ENABLED=false so local demo and unit tests stay open.
# Production and Docker Compose hosts that bind 0.0.0.0 should set AUTH_ENABLED=true.
# AUTH_ENABLED=false
# AUTH_MODE=api_key            # api_key | oidc | both
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# API_BIND_HOST=127.0.0.1
# AUTH_REFUSE_INSECURE_BIND=false

# Seconds the worker sleeps between polling for new jobs when the queue is empty.
WORKER_POLL_INTERVAL=2

# Ingest queue backpressure. POST /v1/ingestions and POST /v1/ingestions/lines
# return 429 INGEST_QUEUE_FULL + Retry-After when pending worker jobs >= max.
# Tail ticks skip the same ceiling. Distinct from RATE_LIMITED (token bucket).
INGEST_QUEUE_MAX=100
INGEST_RETRY_AFTER_SECONDS=5

# API token-bucket rate limiting (ingest writes + query routes). In-memory per
# process. 0 rps = unlimited for that category. Defaults are high so local demo
# and tests are not 429'd. Identity is API key id, or "anonymous" when auth is off.
# RATELIMIT_ENABLED=true
# RATELIMIT_INGEST_RPS=100
# RATELIMIT_QUERY_RPS=100
# RATELIMIT_BURST=100
# RATELIMIT_RETRY_AFTER_SECONDS=1

# Max in-flight LLM provider calls (process-wide; independent of API concurrency).
# 0 = unlimited. Noop provider skips the wait.
# LLM_MAX_CONCURRENCY=4
# Max NDJSON lines accepted by POST /v1/ingestions/lines (over cap → 400).
INGEST_PUSH_MAX_LINES=5000
# Tail-mode poll cadence and consecutive-error auto-pause.
TAIL_POLL_INTERVAL=30
TAIL_ERROR_THRESHOLD=5

# HMAC-signed ingest completion callbacks (optional callback_url on POST /v1/ingestions).
# Per-key secrets (whsec_…) are minted with `raglogs keys create` and used when the
# request was authenticated with that API key. WEBHOOK_SECRET is the fallback when
# AUTH_ENABLED=false or the key has no stored signing secret (legacy keys).
# WEBHOOK_SECRET=
# WEBHOOK_MAX_RETRIES=5
# WEBHOOK_TIMEOUT=10

# Idempotency-Key TTL for POST /v1/ingestions (batch enqueue and tail create).
# Repeat requests with the same key within this window return the original job.
# INGEST_IDEMPOTENCY_TTL_SECONDS=86400


# ── Adapters ──────────────────────────────────────────────────────────────────
# AWS region for the cloudwatch source adapter (raglogs ingest --adapter cloudwatch).
# Credentials come from the standard AWS credential chain (env vars, shared config,
# IRSA in-cluster) — never set an access key here.
ADAPTER_CLOUDWATCH_REGION=us-east-1

# Grafana Loki source adapter (raglogs ingest --adapter loki).
# URL is required for /health to report the adapter as available. Auth is optional
# (open Loki) — use Bearer *or* basic, not both. Tenant sets X-Scope-OrgID
# (Grafana Cloud / multi-tenant Loki). Default query is used when ingest params
# omit `query`.
# LOKI_URL=http://localhost:3100
# LOKI_TENANT=
# LOKI_BEARER_TOKEN=
# LOKI_USERNAME=
# LOKI_PASSWORD=
# LOKI_QUERY={job=~".+"}

# Datadog Logs Search API (raglogs ingest --adapter datadog). Both keys are required;
# the application key needs logs_read_data. Site is the Datadog site hostname
# (datadoghq.com, us3.datadoghq.com, datadoghq.eu, ...). page_size max is 1000
# (Datadog API limit). max_rows caps how many events one ingest run will pull.
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_PAGE_SIZE=1000
DATADOG_MAX_ROWS=10000


# ── Cluster severity weights ──────────────────────────────────────────────────
# These control how clusters are ranked by importance.
# Raise a weight to surface that level more prominently in summaries.
SEVERITY_WEIGHT_FATAL=5.0
SEVERITY_WEIGHT_ERROR=4.0
SEVERITY_WEIGHT_WARN=3.0
SEVERITY_WEIGHT_INFO=1.0
SEVERITY_WEIGHT_DEBUG=0.5

