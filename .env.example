# ─────────────────────────────────────────────────────────────────────────────
# raglogs — environment configuration
# Copy this file to .env and fill in your values.
# All variables are optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string with pgvector extension.
# Driver must be psycopg (v3), not psycopg2.
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/raglogs

# Docker Compose default (already set in docker-compose.yml, override here
# only if you're pointing at an external database):
# DB_URL=postgresql+psycopg://postgres:postgres@postgres:5432/raglogs


# ── LLM provider ─────────────────────────────────────────────────────────────
# Controls the explain and ask commands.
# Options: disabled | openai | ollama
# Default: disabled  (deterministic rules-based output, no API calls)
LLM_PROVIDER=disabled

# Model to use when LLM_PROVIDER is openai or ollama.
# OpenAI examples : gpt-4.1-mini  gpt-4.1  gpt-4o
# Ollama examples : llama3  mistral  phi3
LLM_MODEL=gpt-4.1-mini

# API key and base URL for OpenAI (used when LLM_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# When LLM_PROVIDER=ollama, set the Ollama server URL.
OLLAMA_BASE_URL=http://localhost:11434


# ── Embeddings provider ───────────────────────────────────────────────────────
# Controls semantic search over log clusters (future feature).
# Options: disabled | openai | local
# Default: disabled
EMBEDDINGS_PROVIDER=disabled

# Embedding model (used when provider is openai or local).
EMBEDDINGS_MODEL=text-embedding-3-small

# Embedding vector dimensions — must match the model output.
# text-embedding-3-small = 1536, text-embedding-3-large = 3072
EMBEDDINGS_DIMENSIONS=1536


# ── Analysis tuning ───────────────────────────────────────────────────────────
# Baseline comparison window for the explain command.
# Format: <number><unit> where unit is s/m/h/d  (e.g. 24h, 2d, 1h)
DEFAULT_BASELINE_WINDOW=24h

# Maximum number of evidence bullet points in an incident summary.
MAX_EVIDENCE_ITEMS=8

# Maximum number of clusters fed into the explain pipeline.
# Higher = more thorough but slower for large ingestions.
MAX_CLUSTERS_FOR_EXPLAIN=10


# ── Worker ────────────────────────────────────────────────────────────────────
# Seconds the worker sleeps between polling for new jobs when the queue is empty.
WORKER_POLL_INTERVAL=2


# ── Adapters ──────────────────────────────────────────────────────────────────
# AWS region for the cloudwatch source adapter (raglogs ingest --adapter cloudwatch).
# Credentials come from the standard AWS credential chain (env vars, shared config,
# IRSA in-cluster) — never set an access key here.
ADAPTER_CLOUDWATCH_REGION=us-east-1

# Datadog Logs Search API (raglogs ingest --adapter datadog). Both keys are required;
# the application key needs logs_read_data. Site is the Datadog site hostname
# (datadoghq.com, us3.datadoghq.com, datadoghq.eu, ...). page_size max is 1000
# (Datadog API limit). max_rows caps how many events one ingest run will pull.
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_PAGE_SIZE=1000
DATADOG_MAX_ROWS=10000


# ── Cluster severity weights ──────────────────────────────────────────────────
# These control how clusters are ranked by importance.
# Raise a weight to surface that level more prominently in summaries.
SEVERITY_WEIGHT_FATAL=5.0
SEVERITY_WEIGHT_ERROR=4.0
SEVERITY_WEIGHT_WARN=3.0
SEVERITY_WEIGHT_INFO=1.0
SEVERITY_WEIGHT_DEBUG=0.5
